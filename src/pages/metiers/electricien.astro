---
import Base from '../../layouts/Base.astro'
import contenu from '../../contenu/metiers__electricien.html?raw'
import { sectionQuiz, MARQUEUR } from '../../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Permanence téléphonique électricien : ne rien rater"
  description="Panne totale, tableau qui chauffe, devis de rénovation : ce que deviennent vos appels quand vous êtes sous tension. Coûts et tri des urgences."
  chemin="/metiers/electricien"
  og="/images/6aaff3e8effbb6.33919366_permanence-telephone-electricien.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
