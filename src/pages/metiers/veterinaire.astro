---
import Base from '../../layouts/Base.astro'
import contenu from '../../contenu/metiers__veterinaire.html?raw'
import { sectionQuiz, MARQUEUR } from '../../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Permanence téléphonique vétérinaire : répondre 24 h/24"
  description="Urgences, rendez-vous, suivi post-opératoire : ce que deviennent vos appels pendant une consultation. Coûts comparés et tri des situations."
  chemin="/metiers/veterinaire"
  og="/images/6ab005090904c7.63668972_permanence-telephone-veterinaire.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
