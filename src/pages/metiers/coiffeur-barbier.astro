---
import Base from '../../layouts/Base.astro'
import contenu from '../../contenu/metiers__coiffeur-barbier.html?raw'
import { sectionQuiz, MARQUEUR } from '../../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Permanence téléphonique salon de coiffure et barbier"
  description="Appels pendant une couleur, annulations de dernière minute, réservations après la fermeture : ce que deviennent vos appels. Coûts comparés et limites."
  chemin="/metiers/coiffeur-barbier"
  og="/images/6ab00b34a50808.50268557_permanence-telephone-coiffeur-barbier.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
