---
import Base from '../../layouts/Base.astro'
import contenu from '../../contenu/metiers__auto-ecole.html?raw'
import { sectionQuiz, MARQUEUR } from '../../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Permanence téléphonique auto-école 7 jours sur 7"
  description="Demandes de tarifs, inscriptions, annulations de leçon : ce que deviennent vos appels quand vous êtes au volant. Coûts comparés et limites à poser."
  chemin="/metiers/auto-ecole"
  og="/images/6ab0114f24fd52.05968503_auto-ecole-permanence-telephone.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
