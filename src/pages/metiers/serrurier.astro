---
import Base from '../../layouts/Base.astro'
import contenu from '../../contenu/metiers__serrurier.html?raw'
import { sectionQuiz, MARQUEUR } from '../../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Permanence téléphonique serrurier : décrocher 24 h/24"
  description="Porte claquée, effraction, cylindre à changer : vos appels arrivent la nuit et le week-end. Coûts comparés et tri des urgences en serrurerie."
  chemin="/metiers/serrurier"
  og="/images/6aaff54f3a9859.57231340_permanence-telephone-serrurier.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
