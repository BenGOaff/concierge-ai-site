---
import Base from '../../layouts/Base.astro'
import contenu from '../../contenu/metiers__paysagiste.html?raw'
import { sectionQuiz, MARQUEUR } from '../../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Permanence téléphonique paysagiste : ne rien rater"
  description="Devis d'entretien, tailles de saison, tontes à replanifier : vos appels tombent quand la débroussailleuse tourne. Comment les trier sans descendre du terrain."
  chemin="/metiers/paysagiste"
  og="/images/6aaffc3c66fe03.69581027_permanence-telephone-paysagiste.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
