---
import Base from '../../layouts/Base.astro'
import contenu from '../../contenu/metiers__renovation-batiment.html?raw'
import { sectionQuiz, MARQUEUR } from '../../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Permanence téléphonique bâtiment : ne plus rater d'appel"
  description="Demandes de devis, suivi de chantier, délais : vos appels arrivent quand la ponceuse tourne. Coûts comparés et tri des demandes en rénovation."
  chemin="/metiers/renovation-batiment"
  og="/images/6aaff9241f2f13.06191913_permanence-telephone-batiment-renovation.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
