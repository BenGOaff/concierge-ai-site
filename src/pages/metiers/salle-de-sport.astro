---
import Base from '../../layouts/Base.astro'
import contenu from '../../contenu/metiers__salle-de-sport.html?raw'
import { sectionQuiz, MARQUEUR } from '../../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Permanence téléphonique salle de sport et club de fitness"
  description="Demandes de tarifs, séances d'essai, questions d'horaires : ce que deviennent vos appels quand vous êtes sur le plateau. Coûts comparés et limites à poser."
  chemin="/metiers/salle-de-sport"
  og="/images/6ab00ff4cc5ae9.98837204_salle-de-sport-permanence-telephone.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
