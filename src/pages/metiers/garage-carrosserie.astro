---
import Base from '../../layouts/Base.astro'
import contenu from '../../contenu/garage-carrosserie.html?raw'
import { sectionQuiz, MARQUEUR } from '../../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Permanence téléphonique garage et carrosserie 24 h/24"
  description="Véhicule immobilisé, devis, rendez-vous d'atelier : vos appels arrivent pendant que vous êtes sous un pont. Coûts comparés et tri des demandes."
  chemin="/metiers/garage-carrosserie"
  og="/images/6aaff861464de0.74222351_permanence-telephone-garagiste-carrossier.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
