---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/posts.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Tous les articles sur les appels manqués"
  description="Appels manqués, rendez-vous annulés, urgences, soirées à rappeler : tous les articles pour les indépendants qui ne peuvent pas décrocher en travaillant."
  chemin="/posts"
  og="/images/6ab0f3f12adce8.67682388_blog.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
