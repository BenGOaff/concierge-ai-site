---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/partir-en-vacances-independant.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  id: 'partir-en-vacances-independant',
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions, deux minutes. Vous recevez votre diagnostic par email, avec ce qui correspond à votre situation.`,
}))
---

<Base
  titre="Vacances d'indépendant : partir sans perdre de clients"
  description="Peur de perdre des clients en partant ? Comment prévenir, gérer vos appels et vraiment couper pendant vos congés d'indépendant, sans rien laisser filer."
  chemin="/partir-en-vacances-independant"
  og="/images/6ab15ad1750777.40601713_partir-en-vacances-independant.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
