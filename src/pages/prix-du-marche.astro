---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/prix-du-marche.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Permanence téléphonique et standard IA : les tarifs 2026"
  description="Les tarifs relevés chez dix prestataires en octobre 2026 : télésecrétariat et standards IA, de 18 à 997 € par mois, ramenés au prix d'une conversation de trois minutes. Calculs détaillés et sources."
  chemin="/prix-du-marche"
  og="/images/6aafeb3971e724.23842765_prix-permanence-telephone-artisans.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
