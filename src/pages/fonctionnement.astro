---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/fonctionnement.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Comment fonctionne un standard téléphonique automatique"
  description="Le téléphone sonne d'abord chez vous. Ce qui se passe ensuite, ce que vous paramétrez, et comment la ligne est en service en 48 heures."
  chemin="/fonctionnement"
  og="/images/6aafe541c11bb6.25165308_fonctionnement-concierge-ai.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
