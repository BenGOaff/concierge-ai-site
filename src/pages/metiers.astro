---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/metiers.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Permanence téléphonique par métier : les 18 couverts"
  description="Dix-huit métiers, dix-huit façons de perdre un appel. Permanence et accueil téléphonique : scènes réelles, coûts comparés et limites d'un standard 24 h/24."
  chemin="/metiers"
  og="/images/6ab017907a4069.19579959_metiers-concierge-ai.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
