---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/telephone-pro-soir-week-end.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  id: 'telephone-pro-soir-week-end',
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions, deux minutes. Vous recevez votre diagnostic par email, avec ce qui correspond à votre situation.`,
}))
---

<Base
  titre="Couper le téléphone pro le soir sans perdre de clients"
  description="Vos clients appellent quand vous avez fini. Comment couper le téléphone pro le soir et le week-end, sans perdre de clients ni vos soirées."
  chemin="/telephone-pro-soir-week-end"
  og="/images/6ab140677b20f9.96514918_telephone-pro-soir-week-end2.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
