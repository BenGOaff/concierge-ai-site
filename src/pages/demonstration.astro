---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/demonstration.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  id: 'demonstration',
  titre: `Ce que ça donnerait <em>sur votre ligne</em>`,
  chapo: `Vous venez d'entendre un appel. Cinq questions pour savoir ce qui se passe aujourd'hui sur la vôtre, et recevoir votre diagnostic par email.`,
}))
---

<Base
  titre="Démonstration : standard téléphonique 24/7 en appel réel"
  description="Écoutez un appel réel : un client demande un débouchage, le standard propose deux créneaux et pose le rendez-vous. Retranscription intégrale."
  chemin="/demonstration"
  og="/images/6aafda5fda50f7.43583166_demonstration-demo-concierge-ai.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
