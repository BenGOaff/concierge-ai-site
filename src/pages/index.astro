---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/accueil.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  id: 'accueil',
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions, deux minutes. Vous recevez votre diagnostic par email, avec ce qui correspond à votre situation.`,
}))
---

<Base
  titre="Permanence téléphonique artisans : ne ratez plus un appel"
  description="Vous ne pouvez pas décrocher quand vous travaillez. Répondeur, télésecrétariat ou standard 24/7 : le comparatif des coûts, pour 18 métiers."
  chemin="/"
  og="/images/6aafda7e1bf4a8.73647982_accueil-concierge-ai.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
