---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/rendez-vous-non-honores.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Rendez-vous non honorés : comment réduire les lapins"
  description="Clients ou patients qui ne viennent pas : pourquoi les rendez-vous non honorés arrivent, ce qu'ils coûtent, et 6 moyens simples de les réduire."
  chemin="/rendez-vous-non-honores"
  og="/images/6ab1582f2ab689.26543687_rendez-vous-non-honores.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
