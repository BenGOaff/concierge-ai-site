---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/secretariat-telephonique.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui arrive sur votre ligne en dehors des heures couvertes, et ce que ça représente.`,
}))
---

<Base
  titre="Secrétariat téléphonique : ce qu'il fait, où il s'arrête"
  description="Ce qu'un secrétariat téléphonique traite vraiment dans une journée, la différence entre mutualisé et dédié, les heures réellement couvertes, et ce qu'il ne fera pas."
  chemin="/secretariat-telephonique"
  og="/images/secretariat-telephonique-og.jpg"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
