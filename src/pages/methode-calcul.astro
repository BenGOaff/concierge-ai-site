---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/methode-calcul.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Méthode de calcul du coût des appels manqués"
  description="La formule complète, la justification de chaque variable, les fourchettes utilisées avec leur origine et les limites de l'estimation."
  chemin="/methode-calcul"
  og="/images/6aafe893990e74.68755906_methode-calcul-appels-manques-artisant.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
