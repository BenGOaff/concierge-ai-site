---
import Base from '../../layouts/Base.astro'
import contenu from '../../contenu/lexique__conversation-facturee.html?raw'
import { sectionQuiz, MARQUEUR } from '../../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien d'appels <em>vous échappent&nbsp;?</em>`,
  chapo: `Le mot est clair, reste à savoir ce qui se passe chez vous. Cinq questions, deux minutes.`,
}))
---

<Base
  titre="Conversation facturée : ce que le mot recouvre vraiment"
  description="Ce qu'un prestataire appelle une conversation, pourquoi la définition change tout, et les trois unités de facturation du marché avec les prix relevés."
  chemin="/lexique/conversation-facturee"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
