---
import Base from '../../layouts/Base.astro'
import contenu from '../../contenu/lexique__numero-dedie.html?raw'
import { sectionQuiz, MARQUEUR } from '../../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien d'appels <em>vous échappent&nbsp;?</em>`,
  chapo: `Le mot est clair, reste à savoir ce qui se passe chez vous. Cinq questions, deux minutes.`,
}))
---

<Base
  titre="Numéro dédié : pourquoi vous ne changez pas de numéro"
  description="Ce qu'est un numéro dédié, comment il s'articule avec le renvoi d'appel, et pourquoi votre numéro habituel ne change pas."
  chemin="/lexique/numero-dedie"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
