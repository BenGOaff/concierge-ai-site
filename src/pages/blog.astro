---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/blog.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  titre: `Combien vous coûtent <em>vos appels manqués&nbsp;?</em>`,
  chapo: `Cinq questions pour savoir ce qui se passe aujourd'hui sur votre ligne, et ce que vous pouvez changer en premier.`,
}))
---

<Base
  titre="Appels manqués et permanence téléphonique : le blog"
  description="Conseils concrets pour les artisans qui ne peuvent pas décrocher : appels manqués, urgences, soirées à rappeler, et comment ne plus perdre de chantiers."
  chemin="/blog"
  og="/images/6ab0ef4b5957b6.71132931_blog.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
