---
import Base from '../layouts/Base.astro'
import contenu from '../contenu/calculateur.html?raw'
import { sectionQuiz, MARQUEUR } from '../lib/quiz.js'
const contenuAvecQuiz = contenu.replace(MARQUEUR, sectionQuiz({
  id: 'calculateur',
  titre: `Et vous, <em>où en êtes-vous vraiment&nbsp;?</em>`,
  chapo: `Le calcul vous donne un montant. Le test vous dit d'où il vient chez vous, et par quoi commencer. Cinq questions, deux minutes.`,
}))
---

<Base
  titre="Artisans : Calculateur : ce que vous coûtent vos appels manqués"
  description="Combien d'appels restent sans réponse chaque mois, ce qu'ils représentent sur un an, et combien il faut en récupérer pour couvrir un standard 24/7."
  chemin="/calculateur"
  og="/images/6aafe7618ea598.63375751_calcul-appels-manques-artisans.png"
>
  <Fragment set:html={contenuAvecQuiz} />
</Base>
